<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TestFlight edition: distribution signing, no get-task-allow, therefore
     no JIT. Uses the TCI interpreter build of QEMU (UTM SE model). Boots
     Linux and Steam's UI slowly; not suitable for playing games. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(IDECK_APP_GROUP)</string>
	</array>
</dict>
</plist>

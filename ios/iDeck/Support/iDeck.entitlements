<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sideload (JIT) edition. get-task-allow comes from development signing
     and is what lets StikDebug attach and enable JIT. Free Apple IDs can sign
     get-task-allow and increased-memory-limit, not extended-virtual-addressing
     (sideloading tools drop entitlements the account cannot sign). -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(IDECK_APP_GROUP)</string>
	</array>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>

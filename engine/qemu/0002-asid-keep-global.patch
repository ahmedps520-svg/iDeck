-        tlb_flush(CPU(cpu));
+
+        if (cpu->asid_keep_global && !env->tlb_high_ng &&
+            arm_el_is_aa64(env, 1)) {
+            /*
+             * iDeck: QEMU's TLB has no ASID, so an ASID change must drop
+             * every entry that belongs to an ASID: the non-global ones.
+             * No non-global mapping has been walked in the upper (TTBR1)
+             * half since the last full flush, so every upper-half entry
+             * is global and stays valid; the lower half is dropped
+             * whole. Only the EL1&0 regime uses this ASID. Linux without
+             * KPTI maps the kernel global, and keeps it here across
+             * every process switch.
+             */
+            tlb_flush_low_by_mmuidx(CPU(cpu),
+                                    ARMMMUIdxBit_E10_0 |
+                                    ARMMMUIdxBit_E10_1 |

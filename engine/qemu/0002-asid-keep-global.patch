@@ -417,6 +417,80 @@ void tlb_flush(CPUState *cpu)
     tlb_flush_by_mmuidx(cpu, ALL_MMUIDX_BITS);
 }
 
+static inline bool tlb_entry_in_use(const CPUTLBEntry *te)
+{
+    return te->addr_read != -1 || te->addr_write != -1 || te->addr_code != -1;
+}
+
+/* The page address of an entry in use, with its flag bits. */
+static inline vaddr tlb_entry_any_addr(const CPUTLBEntry *te)
+{
+    if (te->addr_read != -1) {
+        return te->addr_read;
+    }
+    if (te->addr_write != -1) {
+        return te->addr_write;
+    }
+    return te->addr_code;
+}
+
+void tlb_flush_low_by_mmuidx(CPUState *cpu, uint16_t idxmap, unsigned bit)
+{
+    const vaddr high = (vaddr)1 << bit;
+    int64_t now = get_clock_realtime();
+    CPUJumpCache *jc;
+    uint16_t work;
+
+    assert_cpu_is_self(cpu);
+
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    /* Indexes that are not dirty are empty. They stay marked dirty here. */
+    for (work = idxmap & cpu->neg.tlb.c.dirty; work != 0; work &= work - 1) {
+        int mmu_idx = ctz32(work);
+        CPUTLBDesc *desc = &cpu->neg.tlb.d[mmu_idx];
+        CPUTLBDescFast *fast = &cpu->neg.tlb.f[mmu_idx];
+        size_t n = tlb_n_entries(fast);
+
+        /* Sizing happens at flushes; a resized table starts empty. */
+        tlb_mmu_resize_locked(desc, fast, now);
+        if (tlb_n_entries(fast) != n) {
+            tlb_mmu_flush_locked(desc, fast);
+            continue;
+        }
+        for (size_t i = 0; i < n; i++) {
+            CPUTLBEntry *te = &fast->table[i];
+
+            if (tlb_entry_in_use(te) && !(tlb_entry_any_addr(te) & high)) {
+                memset(te, -1, sizeof(*te));
+                desc->n_used_entries--;
+            }
+        }
+        for (size_t k = 0; k < CPU_VTLB_SIZE; k++) {
+            CPUTLBEntry *te = &desc->vtable[k];
+
+            if (tlb_entry_in_use(te) && !(tlb_entry_any_addr(te) & high)) {
+                memset(te, -1, sizeof(*te));
+                desc->n_used_entries--;
+            }
+        }
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+
+    /*
+     * A jump cache entry is found by virtual address alone, so the
+     * entries for the flushed half must go. The others still name the
+     * same code: their translations were kept.
+     */
+    jc = cpu->tb_jmp_cache;
+    if (likely(jc != NULL)) {
+        for (int i = 0; i < TB_JMP_CACHE_SIZE; i++) {
+            if (!(jc->array[i].pc & high)) {
+                qatomic_set(&jc->array[i].tb, NULL);
+            }
+        }
+    }
+}

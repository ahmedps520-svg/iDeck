+/*
+ * INDEX_op_host_vfp: run one host FP/AdvSIMD instruction on guest
+ * registers in env.  Only reserved registers are used (the slot
+ * registers and TMP0), so no register allocation is involved; NZCV is
+ * never live between TCG ops on this host.
+ */
+QEMU_BUILD_BUG_ON(TCG_HVFP_GPR != TCG_REG_TMP0);
+/* The slots must be among V8-V15: callee-saved, never allocated. */
+QEMU_BUILD_BUG_ON(TCG_HVFP_VREG(0) < 8 ||
+                  TCG_HVFP_VREG(TCG_HVFP_NSLOTS - 1) > 15);
+
+static void tcg_out_host_vfp(TCGContext *s, const TCGArg *args)
+{
+    const uint32_t mrs_nzcv = 0xd53b4200 | TCG_REG_TMP0;
+    const uint32_t msr_nzcv = 0xd51b4200 | TCG_REG_TMP0;
+    uint32_t insn = args[0];
+    uint64_t ctl = args[1];
+    unsigned kind = ctl & 7;
+    intptr_t xchg = ctl >> 40;
+
+    /*
+     * The exchange words must be reachable with a scaled offset: TMP0
+     * carries data here and cannot also hold a large offset.
+     */
+    tcg_debug_assert(kind == TCG_HVFP_VEC ||
+                     (xchg > 0 && xchg + 8 <= 0x7ff8 && !(xchg & 7)));
+
+    for (int i = 0; i < TCG_HVFP_NSLOTS; i++) {
+        uint32_t l = args[2 + i];
+        if (l & 1) {
+            tcg_out_ld(s, TCG_TYPE_V128,
+                       TCG_REG_V0 + TCG_HVFP_VREG((l >> 1) & 7),
+                       TCG_AREG0, l >> 8);
+        }
+    }
+    if (kind == TCG_HVFP_GPR_IN || kind == TCG_HVFP_FLAGS_INOUT) {
+        tcg_out_ld(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_AREG0, xchg);
+        if (kind == TCG_HVFP_FLAGS_INOUT) {
+            tcg_out32(s, msr_nzcv);
+        }
+    }
+
+    tcg_out32(s, insn);
+
+    switch (kind) {
+    case TCG_HVFP_FLAGS_OUT:
+    case TCG_HVFP_FLAGS_INOUT:
+        tcg_out32(s, mrs_nzcv);
+        tcg_out_st(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_AREG0, xchg);
+        break;
+    case TCG_HVFP_GPR_OUT:
+        tcg_out_st(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_AREG0, xchg);
+        break;
+    case TCG_HVFP_GPR_OUT_FLAGS:
+        tcg_out_st(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_AREG0, xchg);
+        tcg_out32(s, mrs_nzcv);
+        tcg_out_st(s, TCG_TYPE_I64, TCG_REG_TMP0, TCG_AREG0, xchg + 8);
+        break;

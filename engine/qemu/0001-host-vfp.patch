diff --git a/include/tcg/tcg-host-vfp.h b/include/tcg/tcg-host-vfp.h
new file mode 100644
index 0000000..06a51b8
--- /dev/null
+++ b/include/tcg/tcg-host-vfp.h
@@ -0,0 +1,67 @@
+/*
+ * Host FP/AdvSIMD instruction pass-through (iDeck).
+ *
+ * When guest and host are both AArch64, a guest FP/AdvSIMD instruction
+ * whose operands are only V registers (plus, for a few, one general
+ * register or NZCV) can run unchanged on the host CPU instead of going
+ * through a softfloat helper.  INDEX_op_host_vfp does that for one
+ * instruction: it loads the guest V registers it is told to from env
+ * into reserved host registers (the slots), runs the (re-registered)
+ * instruction, and stores the result back.
+ *
+ * The slots are callee-saved registers that TCG never allocates.  Their
+ * low 64 bits therefore survive everything else a translation block
+ * does, helper calls included, which lets the front end keep guest
+ * values in them from one of these ops to the next.  The backend
+ * saves and restores them in its prologue and epilogue.
+ *
+ * The opcode has constant arguments only:
+ *   args[0]     the instruction word, register fields already rewritten
+ *               to TCG_HVFP_VREG(slot) / TCG_HVFP_GPR
+ *   args[1]     control word, see TCG_HVFP_CTL
+ *   args[2..7]  load words, see TCG_HVFP_LOAD; 0 = unused
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef TCG_HOST_VFP_H
+#define TCG_HOST_VFP_H
+
+/* What surrounds the instruction. */
+enum {
+    TCG_HVFP_VEC,           /* V registers only */
+    TCG_HVFP_FLAGS_OUT,     /* then NZCV -> xchg[0] */
+    TCG_HVFP_FLAGS_INOUT,   /* xchg[0] -> NZCV first, NZCV -> xchg[0] after */
+    TCG_HVFP_GPR_OUT,       /* then TCG_HVFP_GPR -> xchg[0] */
+    TCG_HVFP_GPR_OUT_FLAGS, /* then TCG_HVFP_GPR -> xchg[0], NZCV -> xchg[1] */
+    TCG_HVFP_GPR_IN,        /* xchg[0] -> TCG_HVFP_GPR first */
+};
+
+#define TCG_HVFP_NSLOTS      6
+/*
+ * Host V register that holds slot N: V8..V13.  Consecutive, which TBL
+ * needs for its table, and within V8-V15, the callee-saved ones.
+ */
+#define TCG_HVFP_VREG(slot)  (8 + (slot))
+/* Host general register used by the GPR and flags kinds (x16). */
+#define TCG_HVFP_GPR         16
+
+/* Load a 128-bit guest register at env + OFS into slot SLOT. */
+#define TCG_HVFP_LOAD(slot, ofs) \
+    (((uint32_t)(ofs) << 8) | ((slot) << 1) | 1)
+
+/*
+ * Control word: KIND; whether to store slot SSLOT (128 bits) to
+ * env + SOFS afterwards; and the env offset of the two 64-bit exchange
+ * words used by the flags and GPR kinds.
+ */
+#define TCG_HVFP_CTL(kind, store, sslot, sofs, xchg) \
+    ((uint64_t)(kind) | ((store) ? 8 : 0) | ((uint64_t)(sslot) << 4) | \
+     ((uint64_t)(uint32_t)(sofs) << 8) | ((uint64_t)(uint32_t)(xchg) << 40))
+
+/* True if this build's TCG backend implements INDEX_op_host_vfp. */
+bool tcg_host_vfp_supported(void);
+void tcg_gen_host_vfp(uint32_t insn, uint64_t ctl,
+                      const uint32_t loads[TCG_HVFP_NSLOTS]);
+
+#endif /* TCG_HOST_VFP_H */

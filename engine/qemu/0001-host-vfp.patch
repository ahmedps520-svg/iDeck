+extern __thread bool float_host_flags_live;
+
+static inline uint64_t float_host_flags_save(void)
+{
+#ifdef __aarch64__
+    if (float_host_flags_live) {
+        uint64_t v;
+        asm volatile("mrs %0, fpsr" : "=r"(v));
+        return v;
+    }
+#endif

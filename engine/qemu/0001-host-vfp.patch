diff --git a/target/arm/tcg/host-vfp.c b/target/arm/tcg/host-vfp.c
new file mode 100644
index 0000000..c3f4387
--- /dev/null
+++ b/target/arm/tcg/host-vfp.c
@@ -0,0 +1,202 @@
+/*
+ * AArch64 guest FP/AdvSIMD instructions run on an AArch64 host (iDeck):
+ * host FPCR/FPSR management.  See host-vfp.h.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "internals.h"
+#include "fpu/softfloat.h"
+#include "tcg/tcg-host-vfp.h"
+#include "host-vfp.h"
+
+#ifdef ARM_HOST_VFP
+
+#include "host/cpuinfo.h"
+
+#ifdef CONFIG_DARWIN
+#include <sys/sysctl.h>
+#else
+#include "elf.h"
+#ifndef HWCAP_SHA1
+#define HWCAP_SHA1  (1 << 5)
+#endif
+#ifndef HWCAP_SHA2
+#define HWCAP_SHA2  (1 << 6)
+#endif
+#ifndef HWCAP_JSCVT
+#define HWCAP_JSCVT (1 << 13)
+#endif
+#endif
+
+/* Cumulative exception bits: IOC, DZC, OFC, UFC, IXC, IDC. */
+#define HOST_FPSR_CEXC  0x9fu
+
+static inline uint64_t host_fpcr_read(void)
+{
+    uint64_t v;
+    asm volatile("mrs %0, fpcr" : "=r"(v));
+    return v;
+}
+
+static inline void host_fpcr_write(uint64_t v)
+{
+    asm volatile("msr fpcr, %0" : : "r"(v));
+}
+
+static inline uint64_t host_fpsr_read(void)
+{
+    uint64_t v;
+    asm volatile("mrs %0, fpsr" : "=r"(v));
+    return v;
+}
+
+static inline void host_fpsr_write(uint64_t v)
+{
+    asm volatile("msr fpsr, %0" : : "r"(v));
+}
+
+/* Guest FPCR bits the host FPCR takes over: every ARMv8.0 CPU has them. */
+#define HOST_FPCR_MASK  (FPCR_RMODE_MASK | FPCR_FZ | FPCR_DN | FPCR_AHP)
+
+static struct {
+    uint32_t feats;
+} host;
+
+/* The guest whose FP environment the host registers of this thread hold. */
+static __thread CPUARMState *live_env;
+static __thread uint64_t saved_fpcr, saved_fpsr;
+
+#ifdef CONFIG_DARWIN
+static bool host_sysctl_bool(const char *name)
+{
+    int val = 0;
+    size_t len = sizeof(val);
+
+    return sysctlbyname(name, &val, &len, NULL, 0) == 0 && val != 0;
+}
+#endif
+
+static void host_probe(void)
+{
+    host.feats = 1u << ARM_HOST_VFP_FEAT_NONE;
+    if (cpuinfo & CPUINFO_AES) {
+        host.feats |= 1u << ARM_HOST_VFP_FEAT_AES;
+    }
+    if (cpuinfo & CPUINFO_PMULL) {
+        host.feats |= 1u << ARM_HOST_VFP_FEAT_PMULL;
+    }
+#ifdef CONFIG_DARWIN
+    if (host_sysctl_bool("hw.optional.arm.FEAT_SHA1")) {
+        host.feats |= 1u << ARM_HOST_VFP_FEAT_SHA1;
+    }
+    if (host_sysctl_bool("hw.optional.arm.FEAT_SHA256")) {
+        host.feats |= 1u << ARM_HOST_VFP_FEAT_SHA256;
+    }
+    if (host_sysctl_bool("hw.optional.arm.FEAT_JSCVT")) {
+        host.feats |= 1u << ARM_HOST_VFP_FEAT_JSCVT;
+    }
+#else
+    {
+        unsigned long hwcap = qemu_getauxval(AT_HWCAP);
+
+        if (hwcap & HWCAP_SHA1) {
+            host.feats |= 1u << ARM_HOST_VFP_FEAT_SHA1;
+        }
+        if (hwcap & HWCAP_SHA2) {
+            host.feats |= 1u << ARM_HOST_VFP_FEAT_SHA256;
+        }
+        if (hwcap & HWCAP_JSCVT) {
+            host.feats |= 1u << ARM_HOST_VFP_FEAT_JSCVT;
+        }
+    }
+#endif
+}
+
+static void host_probe_once(void)
+{
+    static gsize once;
+
+    if (g_once_init_enter(&once)) {
+        host_probe();
+        g_once_init_leave(&once, 1);
+    }
+}
+
+bool arm_host_vfp_available(void)
+{
+    return tcg_host_vfp_supported();
+}
+
+bool arm_host_vfp_has_feat(unsigned feat)
+{
+    host_probe_once();
+    return host.feats & (1u << feat);
+}
+
+static void host_fpcr_apply(CPUARMState *env)
+{
+    uint64_t guest = env->vfp.fpcr & HOST_FPCR_MASK;
+
+    host_fpcr_write((saved_fpcr & ~(uint64_t)HOST_FPCR_MASK) | guest);
+    /* The host-FPU fast path of softfloat assumes round-to-nearest. */
+    float_host_rounding_altered = (guest & FPCR_RMODE_MASK) != 0;
+}
+
+void arm_host_vfp_exec_enter(CPUARMState *env)
+{
+    if (live_env != NULL) {
+        /*
+         * The last cpu_exec on this thread left through a longjmp past
+         * the exit hook (cpu_exec_step_atomic does). The host registers
+         * still hold that guest's environment and flags, and saved_*
+         * still hold the thread's own.
+         */
+        live_env->vfp.fpsr |= host_fpsr_read() & HOST_FPSR_CEXC;
+    } else {
+        saved_fpcr = host_fpcr_read();
+        saved_fpsr = host_fpsr_read();
+    }
+    live_env = env;
+    float_host_flags_live = true;
+    host_fpsr_write(0);
+    host_fpcr_apply(env);
+}
+
+void arm_host_vfp_exec_exit(CPUARMState *env)
+{
+    if (live_env != env) {
+        return;
+    }
+    env->vfp.fpsr |= host_fpsr_read() & HOST_FPSR_CEXC;
+    live_env = NULL;
+    float_host_flags_live = false;
+    float_host_rounding_altered = false;
+    host_fpsr_write(saved_fpsr);
+    host_fpcr_write(saved_fpcr);
+}
+
+void arm_host_vfp_fpcr_changed(CPUARMState *env)
+{
+    if (live_env == env) {
+        host_fpcr_apply(env);
+    }
+}
+
+void arm_host_vfp_sync_fpsr(CPUARMState *env)
+{
+    if (live_env == env) {
+        env->vfp.fpsr |= host_fpsr_read() & HOST_FPSR_CEXC;
+    }
+}
+
+void arm_host_vfp_reset_fpsr(CPUARMState *env)
+{
+    if (live_env == env) {
+        host_fpsr_write(0);
+    }
+}
+
+#endif /* ARM_HOST_VFP */

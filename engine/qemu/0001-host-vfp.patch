diff --git a/target/arm/host-vfp.h b/target/arm/host-vfp.h
new file mode 100644
index 0000000..9df321f
--- /dev/null
+++ b/target/arm/host-vfp.h
@@ -0,0 +1,63 @@
+/*
+ * AArch64 guest FP/AdvSIMD instructions run on an AArch64 host (iDeck).
+ *
+ * With "-cpu ...,x-host-vfp=on" the A64 translator emits the guest's own
+ * instruction for a fixed list of FP/AdvSIMD encodings (host-vfp-a64.c.inc)
+ * instead of calling softfloat helpers.  For that to be exact:
+ *  - while a vCPU thread executes guest code, the host FPCR holds the
+ *    guest's rounding mode, FZ, DN and AHP.  FEAT_AFP (FPCR.AH, FIZ, NEP)
+ *    is hidden from the guest, whatever the host has, so that every
+ *    host behaves like the hosts this was tested on;
+ *  - the host FPSR accumulates the guest's cumulative exception bits and
+ *    is folded into env->vfp.fpsr whenever that is read, written or the
+ *    thread leaves cpu_exec.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef TARGET_ARM_HOST_VFP_H
+#define TARGET_ARM_HOST_VFP_H
+
+#if defined(__aarch64__) && defined(CONFIG_TCG) && \
+    !defined(CONFIG_TCG_INTERPRETER) && \
+    !defined(CONFIG_TCG_THREADED_INTERPRETER) && \
+    !defined(CONFIG_USER_ONLY)
+#define ARM_HOST_VFP 1
+#endif
+
+/* Host CPU features that individual patterns need. */
+enum {
+    ARM_HOST_VFP_FEAT_NONE,
+    ARM_HOST_VFP_FEAT_JSCVT,
+    ARM_HOST_VFP_FEAT_AES,
+    ARM_HOST_VFP_FEAT_SHA1,
+    ARM_HOST_VFP_FEAT_SHA256,
+    ARM_HOST_VFP_FEAT_PMULL,
+};
+
+#ifdef ARM_HOST_VFP
+/* True if this build and host can run guest FP instructions directly. */
+bool arm_host_vfp_available(void);
+/* True if the host has the feature (ARM_HOST_VFP_FEAT_*). */
+bool arm_host_vfp_has_feat(unsigned feat);
+
+/* The vCPU thread enters/leaves cpu_exec for @env. */
+void arm_host_vfp_exec_enter(CPUARMState *env);
+void arm_host_vfp_exec_exit(CPUARMState *env);
+/* env->vfp.fpcr changed. */
+void arm_host_vfp_fpcr_changed(CPUARMState *env);
+/* Fold the host cumulative exception bits into env->vfp.fpsr. */
+void arm_host_vfp_sync_fpsr(CPUARMState *env);
+/* env->vfp.fpsr was written by the guest: drop the bits the host holds. */
+void arm_host_vfp_reset_fpsr(CPUARMState *env);
+#else
+static inline bool arm_host_vfp_available(void) { return false; }
+static inline bool arm_host_vfp_has_feat(unsigned feat) { return false; }
+static inline void arm_host_vfp_exec_enter(CPUARMState *env) {}
+static inline void arm_host_vfp_exec_exit(CPUARMState *env) {}
+static inline void arm_host_vfp_fpcr_changed(CPUARMState *env) {}
+static inline void arm_host_vfp_sync_fpsr(CPUARMState *env) {}
+static inline void arm_host_vfp_reset_fpsr(CPUARMState *env) {}
+#endif
+
+#endif /* TARGET_ARM_HOST_VFP_H */
diff --git a/target/arm/tcg/host-vfp-a64.c.inc b/target/arm/tcg/host-vfp-a64.c.inc
new file mode 100644
index 0000000..d0f64f2
--- /dev/null
+++ b/target/arm/tcg/host-vfp-a64.c.inc
@@ -0,0 +1,391 @@
+/*
+ * A64 FP/AdvSIMD instructions that run on an AArch64 host as they are
+ * (iDeck, "-cpu ...,x-host-vfp=on").  Included by translate-a64.c.
+ *
+ * host_vfp_try() recognises the encodings listed in host-vfp-pats.c.inc
+ * (generated by iDeck's engine/hostvfp_spec.py, which also generates the
+ * test that compares each of them with real hardware) and emits one
+ * INDEX_op_host_vfp for them: the guest V registers the instruction names
+ * are brought into host slot registers, the instruction runs with its
+ * register fields renumbered, and the result is stored back to env.
+ * Guest registers that are the same stay the same host register, so
+ * aliasing behaves as on hardware.  See host-vfp.h for the FPCR/FPSR side.
+ *
+ * Slot cache.  The slot registers are V8-V13, whose low 64 bits every
+ * function preserves (AAPCS64) and which TCG never allocates.  Within one
+ * translation block the translator remembers which guest register each
+ * slot holds, so a value produced by one of these instructions reaches the
+ * next one in a register instead of through env:
+ *  - results are always stored to env as well, so env is exact at every
+ *    instruction boundary and forgetting a slot is always safe;
+ *  - any other instruction may call a helper (softmmu slow path included),
+ *    after which only the low 64 bits of a slot are known: slots drop from
+ *    "full" to "low", enough for scalar operands;
+ *  - any other instruction that can write a V register makes the slot for
+ *    that register (or all slots, where the encoding is not decoded here)
+ *    forgotten;
+ *  - the cache starts empty in every translation block.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+typedef struct HostVfpPat {
+    uint32_t mask;
+    uint32_t value;
+    uint32_t flags;
+} HostVfpPat;
+
+/* flags; the low three bits are the TCG_HVFP_* kind */
+#define HV_KIND_MASK   7
+#define HV_RD          (1 << 3)   /* Rd names a V register that is written */
+#define HV_RD_IN       (1 << 4)   /* ... and its old value is an input */
+#define HV_RN          (1 << 5)   /* Rn names a V register */
+#define HV_RM          (1 << 6)   /* Rm names a V register */
+#define HV_RA          (1 << 7)   /* Ra names a V register */
+#define HV_SCALAR      (1 << 8)   /* scalar result: FPCR.NEP merges old Rd */
+#define HV_VEC_SD      (1 << 9)   /* Q=0 with sz=1 is unallocated */
+#define HV_Q1          (1 << 10)  /* only allocated with Q=1 */
+#define HV_NO_AH       (1 << 11)  /* depends on FEAT_RPRES when FPCR.AH=1 */
+#define HV_TBL         (1 << 12)  /* table registers Rn .. Rn+len */
+#define HV_IN_LO       (1 << 13)  /* V inputs are scalars: low 64 bits */
+#define HV_FEAT_SHIFT  16
+
+/* What is known about a slot register */
+#define HV_SLOT_NONE   0
+#define HV_SLOT_LOW    1          /* low 64 bits equal the guest register */
+#define HV_SLOT_FULL   2          /* all 128 bits do */
+
+static const HostVfpPat host_vfp_pats[] = {
+#include "host-vfp-pats.c.inc"
+};
+
+/* The exchange words and every V register must be directly addressable. */
+QEMU_BUILD_BUG_ON(offsetof(CPUARMState, vfp.host_xchg) % 8 != 0);
+QEMU_BUILD_BUG_ON(offsetof(CPUARMState, vfp.host_xchg) + 16 > 0x7ff8);
+QEMU_BUILD_BUG_ON(offsetof(CPUARMState, vfp.zregs) % 16 != 0);
+QEMU_BUILD_BUG_ON(sizeof(ARMVectorReg) % 16 != 0);
+QEMU_BUILD_BUG_ON(offsetof(CPUARMState, vfp.zregs[31]) > 0xfff * 16);
+QEMU_BUILD_BUG_ON(ARRAY_SIZE(((DisasContext *)0)->hv_greg) != TCG_HVFP_NSLOTS);
+
+static bool host_vfp_guest_has(DisasContext *s, unsigned feat)
+{
+    switch (feat) {
+    case ARM_HOST_VFP_FEAT_NONE:
+        return true;
+    case ARM_HOST_VFP_FEAT_JSCVT:
+        return dc_isar_feature(aa64_jscvt, s);
+    case ARM_HOST_VFP_FEAT_AES:
+        return dc_isar_feature(aa64_aes, s);
+    case ARM_HOST_VFP_FEAT_SHA1:
+        return dc_isar_feature(aa64_sha1, s);
+    case ARM_HOST_VFP_FEAT_SHA256:
+        return dc_isar_feature(aa64_sha256, s);
+    case ARM_HOST_VFP_FEAT_PMULL:
+        return dc_isar_feature(aa64_pmull, s);
+    default:
+        return false;
+    }
+}
+
+static void host_vfp_forget_all(DisasContext *s)
+{
+    for (int i = 0; i < TCG_HVFP_NSLOTS; i++) {
+        s->hv_greg[i] = -1;
+        s->hv_valid[i] = HV_SLOT_NONE;
+    }
+}
+
+static void host_vfp_forget(DisasContext *s, int greg)
+{
+    for (int i = 0; i < TCG_HVFP_NSLOTS; i++) {
+        if (s->hv_greg[i] == greg) {
+            s->hv_greg[i] = -1;
+            s->hv_valid[i] = HV_SLOT_NONE;
+        }
+    }
+}
+
+static int host_vfp_find(DisasContext *s, int greg)
+{
+    for (int i = 0; i < TCG_HVFP_NSLOTS; i++) {
+        if (s->hv_greg[i] == greg) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+/*
+ * An instruction that host_vfp_try() did not emit is about to be
+ * translated.  It may call a helper, and it may write V registers.
+ */
+static void host_vfp_other_insn(DisasContext *s, uint32_t insn)
+{
+    unsigned op0 = extract32(insn, 25, 4);
+    bool any = false;
+
+    for (int i = 0; i < TCG_HVFP_NSLOTS; i++) {
+        if (s->hv_valid[i] == HV_SLOT_FULL) {
+            s->hv_valid[i] = HV_SLOT_LOW;
+        }
+        any |= s->hv_valid[i] != HV_SLOT_NONE;
+    }
+    if (!any) {
+        return;
+    }
+
+    if ((op0 & 7) == 7) {
+        /*
+         * Scalar floating point and AdvSIMD: the only V register such an
+         * instruction writes is the one in bits 4:0.
+         */
+        host_vfp_forget(s, extract32(insn, 0, 5));
+    } else if ((op0 & 5) == 4) {
+        /* Loads and stores; bit 26 selects the SIMD&FP registers. */
+        if (!(op0 & 2)) {
+            return;
+        }
+        switch (extract32(insn, 27, 3)) {
+        case 3: /* LDR (literal) */
+            host_vfp_forget(s, extract32(insn, 0, 5));
+            break;
+        case 5: /* LDP, LDNP, STP, STNP */
+            if (extract32(insn, 22, 1)) {
+                host_vfp_forget(s, extract32(insn, 0, 5));
+                host_vfp_forget(s, extract32(insn, 10, 5));
+            }
+            break;
+        case 7: /* LDR, LDUR, STR, STUR */
+            if (extract32(insn, 22, 1)) {
+                host_vfp_forget(s, extract32(insn, 0, 5));
+            }
+            break;
+        default: /* LD1..LD4, LD1R..: several registers */
+            host_vfp_forget_all(s);
+            break;
+        }
+    } else if (op0 < 4) {
+        /* SVE, SME and unallocated space. */
+        host_vfp_forget_all(s);
+    }
+}
+
+typedef struct HostVfpEmit {
+    uint32_t loads[TCG_HVFP_NSLOTS];
+    int nloads;
+    unsigned pinned;    /* slots this instruction uses */
+} HostVfpEmit;
+
+/* A slot for @greg: the one that holds it, else the least recently used. */
+static int host_vfp_slot(DisasContext *s, HostVfpEmit *e, int greg)
+{
+    int sl = host_vfp_find(s, greg);
+
+    if (sl < 0) {
+        for (int i = 0; i < TCG_HVFP_NSLOTS; i++) {
+            if (e->pinned & (1u << i)) {
+                continue;
+            }
+            if (s->hv_greg[i] < 0) {
+                sl = i;
+                break;
+            }
+            if (sl < 0 || s->hv_used[i] < s->hv_used[sl]) {
+                sl = i;
+            }
+        }
+        g_assert(sl >= 0);
+        s->hv_greg[sl] = greg;
+        s->hv_valid[sl] = HV_SLOT_NONE;
+    }
+    e->pinned |= 1u << sl;
+    s->hv_used[sl] = ++s->hv_tick;
+    return sl;
+}
+
+/* The slot for input @greg; loads it from env unless the slot has it. */
+static int host_vfp_in(DisasContext *s, HostVfpEmit *e, int greg, int need)
+{
+    int sl = host_vfp_slot(s, e, greg);
+
+    if (s->hv_valid[sl] < need) {
+        g_assert(e->nloads < TCG_HVFP_NSLOTS);
+        e->loads[e->nloads++] = TCG_HVFP_LOAD(sl, vec_full_reg_offset(s, greg));
+        s->hv_valid[sl] = HV_SLOT_FULL;
+    }
+    return sl;
+}
+
+/*
+ * If @insn is on the list, emit it as a host instruction and return true
+ * (also when all that was emitted is the FP access trap).
+ */
+static bool host_vfp_try(DisasContext *s, uint32_t insn)
+{
+    const int xchg = offsetof(CPUARMState, vfp.host_xchg);
+    const HostVfpPat *p = NULL;
+    HostVfpEmit e = { };
+    uint32_t out = insn;
+    unsigned flags, kind;
+    int rd = extract32(insn, 0, 5);
+    int rn = extract32(insn, 5, 5);
+    int rm = extract32(insn, 16, 5);
+    int ra = extract32(insn, 10, 5);
+    int need, dslot = -1;
+    TCGv_i64 t;
+
+    /* All of them are in the "Scalar Floating-Point and AdvSIMD" class. */
+    if ((insn & 0x0e000000) != 0x0e000000) {
+        return false;
+    }
+    for (int i = 0; i < ARRAY_SIZE(host_vfp_pats); i++) {
+        if ((insn & host_vfp_pats[i].mask) == host_vfp_pats[i].value) {
+            p = &host_vfp_pats[i];
+            break;
+        }
+    }
+    if (!p) {
+        return false;
+    }
+    flags = p->flags;
+    kind = flags & HV_KIND_MASK;
+
+    if (unlikely(s->host_vfp_debug)) {
+        unsigned group = (p - host_vfp_pats) * 24 / ARRAY_SIZE(host_vfp_pats);
+
+        if (s->host_vfp_debug & (1ull << (8 + group))) {
+            return false;
+        }
+    }
+
+    /* Encodings the mask lets through that are unallocated. */
+    if ((flags & HV_VEC_SD) && extract32(insn, 22, 1) && !extract32(insn, 30, 1)) {
+        return false;
+    }
+    if ((flags & HV_Q1) && !extract32(insn, 30, 1)) {
+        return false;
+    }
+    if ((flags & HV_NO_AH) && s->fpcr_ah) {
+        return false;
+    }
+    if (flags >> HV_FEAT_SHIFT) {
+        unsigned feat = flags >> HV_FEAT_SHIFT;
+
+        if (!host_vfp_guest_has(s, feat) || !arm_host_vfp_has_feat(feat)) {
+            return false;
+        }
+    }
+
+    if (!fp_access_check(s)) {
+        return true;
+    }
+    if (unlikely(s->host_vfp_debug & 1)) {
+        host_vfp_forget_all(s);
+    }
+
+    /*
+     * Scalar operands need the low 64 bits only, unless FPCR.NEP makes
+     * the instruction merge the rest of a register into the result.
+     */
+    need = (flags & HV_IN_LO) && !s->fpcr_nep ? HV_SLOT_LOW : HV_SLOT_FULL;
+
+    if (flags & HV_TBL) {
+        /*
+         * The table registers must be consecutive host registers: slots
+         * 2.. hold them, and nothing else is kept across this instruction.
+         */
+        int len = extract32(insn, 13, 2) + 1;
+
+        host_vfp_forget_all(s);
+        for (int i = 0; i < len; i++) {
+            int greg = (rn + i) % 32;
+
+            s->hv_greg[2 + i] = greg;
+            s->hv_valid[2 + i] = HV_SLOT_FULL;
+            s->hv_used[2 + i] = ++s->hv_tick;
+            e.pinned |= 1u << (2 + i);
+            e.loads[e.nloads++] = TCG_HVFP_LOAD(2 + i, vec_full_reg_offset(s, greg));
+        }
+        out = deposit32(out, 5, 5, TCG_HVFP_VREG(2));
+    } else {
+        /* Operands that already sit in a slot keep it. */
+        if ((flags & HV_RN) && host_vfp_find(s, rn) >= 0) {
+            e.pinned |= 1u << host_vfp_find(s, rn);
+        }
+        if ((flags & HV_RM) && host_vfp_find(s, rm) >= 0) {
+            e.pinned |= 1u << host_vfp_find(s, rm);
+        }
+        if ((flags & HV_RA) && host_vfp_find(s, ra) >= 0) {
+            e.pinned |= 1u << host_vfp_find(s, ra);
+        }
+        if ((flags & HV_RD) && host_vfp_find(s, rd) >= 0) {
+            e.pinned |= 1u << host_vfp_find(s, rd);
+        }
+        if (flags & HV_RN) {
+            out = deposit32(out, 5, 5, TCG_HVFP_VREG(host_vfp_in(s, &e, rn, need)));
+        }
+    }
+    if (flags & HV_RM) {
+        out = deposit32(out, 16, 5, TCG_HVFP_VREG(host_vfp_in(s, &e, rm, need)));
+    }
+    if (flags & HV_RA) {
+        out = deposit32(out, 10, 5, TCG_HVFP_VREG(host_vfp_in(s, &e, ra, need)));
+    }
+    if (flags & HV_RD) {
+        if ((flags & HV_RD_IN) || ((flags & HV_SCALAR) && s->fpcr_nep)) {
+            dslot = host_vfp_in(s, &e, rd, HV_SLOT_FULL);
+        } else {
+            dslot = host_vfp_slot(s, &e, rd);
+        }
+        out = deposit32(out, 0, 5, TCG_HVFP_VREG(dslot));
+    }
+
+    switch (kind) {
+    case TCG_HVFP_GPR_IN:
+        out = deposit32(out, 5, 5, TCG_HVFP_GPR);
+        tcg_gen_st_i64(cpu_reg(s, rn), tcg_env, xchg);
+        break;
+    case TCG_HVFP_GPR_OUT:
+    case TCG_HVFP_GPR_OUT_FLAGS:
+        out = deposit32(out, 0, 5, TCG_HVFP_GPR);
+        break;
+    case TCG_HVFP_FLAGS_INOUT:
+        t = tcg_temp_new_i64();
+        gen_get_nzcv(t);
+        tcg_gen_st_i64(t, tcg_env, xchg);
+        break;
+    default:
+        break;
+    }
+
+    tcg_gen_host_vfp(out,
+                     TCG_HVFP_CTL(kind, dslot >= 0, dslot >= 0 ? dslot : 0,
+                                  dslot >= 0 ? vec_full_reg_offset(s, rd) : 0,
+                                  xchg),
+                     e.loads);
+    if (dslot >= 0) {
+        /* The instruction wrote all 128 bits of the register. */
+        s->hv_valid[dslot] = HV_SLOT_FULL;
+    }
+
+    switch (kind) {
+    case TCG_HVFP_FLAGS_OUT:
+    case TCG_HVFP_FLAGS_INOUT:
+        t = tcg_temp_new_i64();
+        tcg_gen_ld_i64(t, tcg_env, xchg);
+        gen_set_nzcv(t);
+        break;
+    case TCG_HVFP_GPR_OUT:
+        tcg_gen_ld_i64(cpu_reg(s, rd), tcg_env, xchg);
+        break;
+    case TCG_HVFP_GPR_OUT_FLAGS:
+        tcg_gen_ld_i64(cpu_reg(s, rd), tcg_env, xchg);
+        t = tcg_temp_new_i64();
+        tcg_gen_ld_i64(t, tcg_env, xchg + 8);
+        gen_set_nzcv(t);
+        break;
+    default:
+        break;
+    }
+    return true;
+}

[Unit]
Description=iDeck: keep Steam's UI idle while it is not on screen
After=ideck-session.service
Wants=ideck-session.service
# CI benchmark boots run without Steam.
ConditionKernelCommandLine=!ideck.noprovision

[Service]
Type=simple
ExecStart=/usr/lib/ideck/steam-ui-daemon
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target

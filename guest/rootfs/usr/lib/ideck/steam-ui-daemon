#!/bin/bash
# steam-ui-daemon — keeps Steam's UI from using the emulated CPU while nobody
# looks at it. Run as root by ideck-steam-ui.service.
#
# Under emulation Steam's UI (Chromium, steamwebhelper) is the heaviest thing
# in the VM, and it kept drawing while the iPad showed iDeck's own screens and
# behind running games. The app writes what the iPad shows to $STATE (through
# the agent's steam.ui operation):
#
#   visible  the Linux screen shows Steam
#   game     the Linux screen shows (or is about to show) a game
#   away     the iPad shows iDeck's own screens; nobody sees Linux
#
# - Leaving "visible": Steam's mapped windows are minimised. Chromium stops
#   drawing minimised windows and throttles their timers. In "away" windows
#   that appear later are minimised too (nobody could answer them now; they
#   come back with the rest). In "game" they are left alone, so dialogs that
#   a game launch needs (EULA, Proton download, cloud conflicts) stay visible.
# - Back to "visible": the windows minimised here are restored; with none,
#   Steam is asked to open its main window.
# - steamwebhelper threads run at nice 19 unless Steam is visible and no game
#   is running, so a game gets the vCPUs. Not SCHED_IDLE: Steam must keep
#   answering, or it reports "steamwebhelper is not responding".
set -u

RUN=/run/ideck
STATE=$RUN/steam-ui                # visible | game | away
STATUS=$RUN/steam-ui.json          # read by the agent (steam.status)
MINIMIZED=$RUN/steam-ui.minimized  # window ids minimised by this daemon
TICK=$RUN/steam-ui.tick            # FIFO: a 1 s pause without spawning sleep

mkdir -p "$RUN"
[ -p "$TICK" ] || mkfifo "$TICK"
exec 3<>"$TICK"

x() { runuser -u deck -- env DISPLAY=:0 HOME=/home/deck "$@" 2>/dev/null; }

# Steam's top-level windows that are on screen now (WM_CLASS steam or
# steamwebhelper; openbox-rc.xml matches the same classes).
visible_windows() { x xdotool search --onlyvisible --class '^(steam|steamwebhelper)$'; }

MINCOUNT=0
minimize_visible() {
    local id
    for id in $(visible_windows); do
        if x xdotool windowminimize "$id"; then
            echo "$id" >> "$MINIMIZED"
            MINCOUNT=$((MINCOUNT + 1))
        fi
    done
}

restore() {
    local id restored=0
    if [ -s "$MINIMIZED" ]; then
        while read -r id; do
            x xdotool windowactivate "$id" && restored=1
        done < "$MINIMIZED"
    fi
    : > "$MINIMIZED"
    MINCOUNT=0
    if [ "$restored" = 0 ] && [ -z "$(visible_windows)" ] && pgrep -x steam >/dev/null; then
        /usr/lib/ideck/ideck-steam-url steam://open/main >/dev/null 2>&1 &
    fi
}

# Sets the nice value of every steamwebhelper thread that differs from $1.
# Nice values are per thread on Linux, so each task is listed. Reads /proc
# with builtins only: under emulation every spawned process is expensive.
WEBHELPERS=0
set_webhelper_nice() {
    local target=$1 pid task stat rest tids=() f=()
    WEBHELPERS=0
    for pid in $(pgrep -x steamwebhelper); do
        WEBHELPERS=$((WEBHELPERS + 1))
        for task in /proc/"$pid"/task/*; do
            IFS= read -r stat < "$task/stat" 2>/dev/null || continue
            rest=${stat##*) }   # after "pid (comm) "; comm may contain spaces
            read -r -a f <<< "$rest"
            # Fields after comm start at "state" (field 3); nice is field 19.
            [ "${f[16]:-}" = "$target" ] || tids+=("${task##*/}")
        done
    done
    if [ "${#tids[@]}" -gt 0 ]; then
        # Absolute nice per thread (util-linux renice -n is relative since
        # 2.38). perl-base is essential in Debian. New threads inherit the
        # value, so this rarely runs once a state is applied.
        perl -e 'my $p = shift; setpriority(0, $_, $p) for @ARGV' "$target" "${tids[@]}" 2>/dev/null || true
    fi
}

last=visible
tick=0
status_written=""
: > "$MINIMIZED"
while :; do
    read -r -t 1 -u 3 _ || true
    want=visible
    if [ -r "$STATE" ]; then read -r want < "$STATE" || want=visible; fi
    case "$want" in visible|game|away) ;; *) want=visible ;; esac

    if [ "$want" != "$last" ]; then
        if [ "$want" = visible ]; then restore; else minimize_visible; fi
        last=$want
        tick=0
    fi
    if [ $((tick % 3)) -eq 0 ]; then
        game=false
        pgrep -f 'SteamLaunch AppId=' >/dev/null && game=true
        nice=0
        if [ "$want" != visible ] || [ "$game" = true ]; then nice=19; fi
        [ "$want" = away ] && minimize_visible
        set_webhelper_nice "$nice"
        status="{\"state\": \"$want\", \"game_running\": $game, \"webhelper_nice\": $nice, \"webhelpers\": $WEBHELPERS, \"minimized\": $MINCOUNT}"
        if [ "$status" != "$status_written" ]; then
            printf '%s\n' "$status" > "$STATUS.tmp" && mv -f "$STATUS.tmp" "$STATUS"
            status_written=$status
        fi
    fi
    tick=$((tick + 1))
done

#!/bin/sh
# taskset as the Steam client sees it (ideck-steam-launch puts this directory
# first in Steam's PATH). Steam's steamrtarm64/steamwebhelper.sh runs
#   exec taskset 0x7c .../steamwebhelper ARGS
# which pins Steam's whole UI (Chromium) to CPUs 2-6, the big cores of
# Valve's Steam Frame. In the VM that is 2 of 4 vCPUs, 4 of 6, and no CPU at
# all with 2 vCPUs (taskset then fails and the UI never starts). The web
# helper is therefore started without a CPU mask; any other call goes to
# util-linux taskset unchanged.
#
# IDECK_STEAM_WEBHELPER_GL=zink (Settings > GPU-drawn Steam UI, experimental):
# the web helper's OpenGL goes through Mesa's Zink on Vulkan (Venus), so
# Chromium draws on the GPU instead of the emulated CPU. Only the web helper
# gets it; games started by Steam keep their own drivers.
if [ "$#" -ge 2 ] && [ "${2##*/}" = steamwebhelper ]; then
    shift
    case "${IDECK_STEAM_WEBHELPER_GL:-}" in
        zink)
            export MESA_LOADER_DRIVER_OVERRIDE=zink ;;
        zink-cpu)
            # CI only: Zink on lavapipe (Mesa's Zink uses a CPU Vulkan
            # device only when software rendering is requested).
            export MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink LIBGL_ALWAYS_SOFTWARE=1 ;;
    esac
    exec "$@"
fi
exec /usr/bin/taskset "$@"
